  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAE08\uACE0\uAC00 \uD574\uC81C \uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uC774\uB3D9
    \uC0AC\uC9C4\uC740 \uB2E8 \uD55C\uBC88\uB9CC \uC0AC\uC6A9 \uD560 \uC218 \uC788\uC73C\uBA70
    \uC2E0\uC911\uD558\uAC8C \uC0AC\uC6A9\uD558\uC154\uC57C \uD569\uB2C8\uB2E4. \uB610
    \uD55C \uC99D\uAC70\uBB3C \uCDE8\uB4DD\uC5D0 \uC2E4\uD328\uD55C\uB2E4\uBA74 \uAC8C\uC784
    \uC9C4\uD589\uC744 \uD558\uC2E4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uAC8C\uC784\uC9C4\uD589\uB3C4\uB294
    \uD654\uC774\uD2B8\uBCF4\uB4DC\uC5D0\uC11C \uD655\uC778 \uD558\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
    \uC774\uC81C \uCC98\uC74C \uC0AC\uAC74\uC774 \uC77C\uC5B4\uB0AC\uB358 \uC7A5\uC18C\uB85C
    \uC774\uB3D9\uD558\uC5EC \uC0AC\uAC74\uC758 \uC99D\uAC70\uBB3C\uC744 \uCC3E\uC73C\uC138\uC694.
    \uC99D\uAC70\uBB3C\uC744 \uCC3E\uB294\uB2E4\uBA74 \uC0AC\uC9C4\uC744 \uCC0D\uC5B4
    \uC9C4\uD589\uB3C4\uB97C \uCCB4\uD06C \uD558\uC138\uC694."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 64aa26a0c4d8db94ca4cbbfe770c4385, type: 2}
