    - target: {fileID: 5045773773296813815, guid: e35b8ef3b02210c42a7727fa33c3ab9f, type: 3}
      propertyPath: m_text
      value: "\uD604\uC2E4\uC5D0\uC11C \uC99D\uAC70\uB97C \uC778\uBA78\uD558\uACE0
        \uC644\uBCBD\uD558\uAC8C \uC790\uCDE8\uB97C \uAC10\uCD98 \uBC94\uC778. \uD558\uC9C0\uB9CC
        \uADF8\uAC00 \uB0A8\uAE34 \uC720\uC77C\uD55C \uC2E4\uC218\uB294 \uC0AC\uAC74\uC758
        \uC21C\uAC04\uC744 \uB2F4\uC740 '\uACFC\uAC70\uC758 \uC0AC\uC9C4'\uC744 \uB0A8\uACA8\uB454
        \uAC83\uC785\uB2C8\uB2E4. \n\n\uCC28\uC6D0\uC744 \uB118\uB098\uB4DC\uB294
        \uD0D0\uC815\uC778 \uB2F9\uC2E0\uC740 \uC774\uC81C \uC774 \uC0AC\uC9C4\uC744
        \uC2DC\uACF5\uAC04\uC758 \uD1B5\uB85C\uB85C \uC0BC\uC544 \uBC94\uC778\uC744
        \uCD94\uACA9\uD574\uC57C \uD569\uB2C8\uB2E4. \uC774\uB3D9\uC0AC\uC9C4\uC740
        \uC6B0\uCE21 \uD2B8\uB9AC\uAC70 B\uB97C \uB20C\uB7EC \uBCF4\uAD00\uD560 \uC218
        \uC788\uC2B5\uB2C8\uB2E4. \uC0AC\uC9C4 \uC18D \uC11C\uC7AC\uB85C \uC9C4\uC785\uD574
        \uAE08\uACE0\uC758 \uC5F4\uC1E0\uB97C \uD68D\uB4DD\uD558\uACE0, \uC804\uC784
        \uD0D0\uC815\uC758 \uAE08\uACE0\uB97C \uC5F4\uC5B4 \uCD94\uAC00 \uC0AC\uC9C4\uC744
        \uD68D\uB4DD \uD558\uC2ED\uC2DC\uC624."
