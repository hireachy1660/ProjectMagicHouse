  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uBC94\uC778\uC758 \uC77C\uAE30\uC7A5\uC744 \uBC1C\uACAC\uD588\uB2E4.
    \uACB0\uC815\uC801 \uC99D\uAC70\uC778 \uC2E0\uBC1C\uC740 \uC544\uC9C1 \uCC3E\uC9C0
    \uBABB\uD55C \uC0C1\uD669.\n\uACB0\uC815\uC801 \uC99D\uAC70 \uC218\uC9D1\uC744
    \uC704\uD574 \uC606\uC758 \uC218\uC0C9\uC0C1\uC790\uC5D0 \uC99D\uAC70\uD488\uC744
    \uBAA8\uC73C\uBA74 \uACB0\uC815\uC801 \uC99D\uAC70\uB97C \uC5BB\uC744 \uC218
    \uC788\uC744 \uAC83\uC774\uB2E4.\n\uB2E8, <color=yellow>\uB2E8\uC11C \uC218\uC9D1
    \uC21C\uC11C\uAC00 \uD2C0\uB9AC\uBA74</color>  \uC601\uC6D0\uD788 \uBE60\uC838\uB098\uAC08
    \uC218 \uC5C6\uC744 \uAC83\uC774\uB2E4.\n1<color=red>\uBA38\uD50C\uB7EC</color>
    : \uB140\uC11D\uC744 \uCC0C\uB978 \uD53C\uB97C \uB2E6\uC544\uB0B4\uACE0 \uBCBD\uB09C\uB85C\uC5D0
    \uB358\uC84C\uB2E4.\n2<color=red>\uCE7C</color> : \uD53C\uB97C \uC53B\uC5B4\uB0B4\uACE0
    \uBD80\uC5CC \uCC2C\uC7A5\uC5D0 \uC228\uACBC\uB2E4. \n3<color=red>\uC2E0\uBC1C</color>
    : \uACF5\uD130\uC5D0 \uB0A8\uAE34 \uD754\uC801\uC744 \uC9C0\uC6B0\uACE0 \uD558\uC597\uAC8C
    \uB2E6\uC544 \uC5B4\uB518\uAC00\uC5D0 \uC228\uAE34\uAC83 \uAC19\uB2E4 \uD654\uBD84\uC774
    \uC218\uC0C1\uD574\uBCF4\uC778\uB2E4."
