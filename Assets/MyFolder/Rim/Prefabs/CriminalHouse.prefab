  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB3CC\uC774\uD0AC \uC218 \uC5C6\uB294 \uC9D3\uC744 \uC800\uC9C8\uB800\uB2E4...
    \uB098\uB294 \uADF8\uB0A0\uC758 \uD754\uC801\uB4E4\uC744 \uC9D1\uC548 \uACF3\uACF3\uC5D0
    \uC228\uACBC\uB2E4.\n\u25C6\uBA38\uD50C\uB7EC : \uB140\uC11D\uC744 \uCC0C\uB978
    \uD53C\uB97C \uB2E6\uC544\uB0B4\uACE0 \uBCBD\uB09C\uB85C\uC5D0 \uB358\uC84C\uC73C\uB098
    \uD0C0\uC9C0 \uC54A\uACE0 \uAC80\uAC8C \uADF8\uC744\uB9B0 \uCC44 \uB0A8\uC558\uB2E4.
    \uC800\uC8FC\uCC98\uB7FC.\n\u25C6\uCE7C (\uBD80\uC5CC) : \uBE44\uADF9\uC758 \uC2DC\uC791.
    \uD53C\uB97C \uC53B\uC5B4\uB0B4\uACE0 \uBD80\uC5CC \uCC2C\uC7A5\uC5D0 \uC228\uACBC\uB2E4.
    \uD3C9\uBC94\uD55C \uC8FC\uBC29\uB3C4\uAD6C \uC778 \uCC99 \uD558\uBA74 \uC544\uBB34\uB3C4
    \uC54C\uC544\uCC4C \uC218 \uC5C6\uACA0\uC9C0...?\n\u25C6\uC2E0\uBC1C (\uCE68\uC2E4)
    : \uACF5\uD130\uC5D0 \uB0A8\uAE34 \uD754\uC801\uC744 \uC9C0\uC6B0\uACE0 \uD558\uC597\uAC8C
    \uB2E6\uC544 \uCE68\uC2E4 \uCE68\uB300 \uBC11\uC5D0 \uBC00\uC5B4 \uB123\uC5C8\uB2E4.
    \uC7A0\uB4E4 \uB54C \uB9C8\uB2E4 \uADF8 \uB0A0\uC758 \uC545\uBABD\uC744 \uAFBC\uB2E4."
