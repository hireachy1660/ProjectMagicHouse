    \uC790\uCDE8\uB97C \uAC10\uCD98 \uBC94\uC778. \uD558\uC9C0\uB9CC \uADF8\uAC00
    \uB0A8\uAE34 \uC720\uC77C\uD55C \uC2E4\uC218\uB294 \uC0AC\uAC74\uC758 \uC21C\uAC04\uC744
    \uB2F4\uC740 '\uACFC\uAC70\uC758 \uC0AC\uC9C4'\uC744 \uB0A8\uACA8\uB454 \uAC83\uC785\uB2C8\uB2E4.
    \n\n\uCC28\uC6D0\uC744 \uB118\uB098\uB4DC\uB294 \uD0D0\uC815\uC778 \uB2F9\uC2E0\uC740
    \uC774\uC81C \uC774 \uC0AC\uC9C4\uC744 \uC2DC\uACF5\uAC04\uC758 \uD1B5\uB85C\uB85C
    \uC0BC\uC544 \uBC94\uC778\uC744 \uCD94\uACA9\uD574\uC57C \uD569\uB2C8\uB2E4.
    \uC0AC\uC9C4 \uC18D \uC11C\uC7AC\uB85C \uC9C4\uC785\uD574 \uC7A0\uAE34 \uC0AC\uBB3C\uD568\uC758
    \uC5F4\uC1E0\uB97C \uD0C8\uCDE8\uD558\uACE0, \uACFC\uAC70\uC5D0\uC11C \uAC00\uC838\uC628
    \uBB3C\uAC74\uC73C\uB85C \uD604\uC2E4\uC758 \uC778\uACFC\uAD00\uACC4\uB97C \uBE44\uD2C0\uC5B4
    \uBC94\uC778\uC758 \uC2E4\uCCB4\uB97C \uB4DC\uB7EC\uB0B4\uC2ED\uC2DC\uC624."
  m_isRightToLeft: 0
